<% content_for :page_title do %>
  ご意見詳細
<% end %>

<main class="min-h-screen w-full bg-stone-200 pb-24">
  <div class="max-w-2xl mx-auto px-4 pt-10">

    <%= link_to admin_feedbacks_path, class: "inline-flex items-center gap-1 text-sm text-stone-600 hover:text-stone-800 mb-4" do %>
      <span class="material-symbols-outlined text-[18px]">arrow_back</span>
      一覧へ戻る
    <% end %>

    <div class="bg-white/90 rounded-2xl shadow border border-stone-100 p-6 space-y-5">

      <div class="flex items-center justify-between">
        <span class="inline-block px-3 py-1 rounded-full text-sm font-bold bg-amber-100 text-amber-700">
          <%= @feedback.category_label %>
        </span>
        <time class="text-sm text-stone-500">
          <%= @feedback.created_at.strftime("%Y年%m月%d日 %H:%M") %>
        </time>
      </div>

      <div class="border-t border-stone-200 pt-4">
        <h3 class="text-sm font-bold text-stone-700 mb-2">送信者</h3>
        <p class="text-stone-800">
          <%= @feedback.user&.email || "匿名" %>
        </p>
      </div>

      <div class="border-t border-stone-200 pt-4">
        <h3 class="text-sm font-bold text-stone-700 mb-2">内容</h3>
        <p class="text-stone-800 whitespace-pre-wrap bg-stone-50 rounded-xl p-4">
          <%= @feedback.body %>
        </p>
      </div>

      <% if @feedback.screenshots.attached? %>
        <div class="border-t border-stone-200 pt-4">
          <h3 class="text-sm font-bold text-stone-700 mb-2">スクリーンショット</h3>
          <div class="space-y-3">
            <% @feedback.screenshots.each do |screenshot| %>
              <div>
                <%= image_tag screenshot, class: "rounded-xl border border-stone-200 max-w-full" %>
                <p class="text-xs text-stone-500 mt-1">
                  <%= screenshot.filename %>
                </p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>
  </div>
</main>

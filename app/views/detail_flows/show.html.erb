<% back = @step_index > 0 ? detail_flow_step_path(@flow_item.key, @step_index - 1) : message_categories_path %>
<% content_for :back_path, back %>
<% content_for :page_title do %>
  <%= @flow_item.name %>
<% end %>

<main class="flex-grow px-6 pb-24 pt-6 flex flex-col items-center">
    <div class="w-full max-w-md">
      <p class="text-sm text-text-sub-light dark:text-text-sub-dark mb-4">
        <%= t("detail_flows.step_of", current: @step_index + 1, total: @flow_definition[:steps].length) %>
      </p>

      <h2 class="text-2xl font-bold text-text-main-light dark:text-text-main-dark mb-8">
        <%= t("detail_flows.#{@flow_item.detail_flow_key}.#{@step[:key]}.question", default: @step[:key]) %>
      </h2>

      <%= form_with url: detail_flow_step_submit_path(@flow_item.key, @step_index),
          method: :post, data: { turbo: false } do |f| %>
        <div class="flex flex-col gap-4">
          <% @step[:choices].each do |choice| %>
            <label class="flex items-center gap-4 bg-card-light dark:bg-card-dark
                          rounded-2xl p-5 shadow-sm cursor-pointer
                          has-[:checked]:border-2 has-[:checked]:border-orange-500">
              <%= f.radio_button :answer, choice[:value], class: "hidden" %>
              <span class="text-2xl font-bold"><%= choice[:label] %></span>
            </label>
          <% end %>
        </div>

        <% if flash[:alert] %>
          <p class="text-red-500 text-sm mt-2"><%= flash[:alert] %></p>
        <% end %>

        <%= f.submit(@step_index == @flow_definition[:steps].length - 1 ?
          t("detail_flows.tell") : t("detail_flows.next"),
          class: "mt-8 w-full bg-amber-600 text-white text-xl font-bold py-5 rounded-2xl shadow-lg cursor-pointer") %>
      <% end %>
    </div>
  </main>

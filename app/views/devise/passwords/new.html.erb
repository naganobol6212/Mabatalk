<main class="flex-grow w-full max-w-md mx-auto px-6 py-8 pb-32">

  <!-- タイトル -->
  <div class="text-center mb-4">
    <h2 class="text-2xl font-bold mb-2">パスワードを忘れた方へ</h2>
    <p class="text-sm text-gray-500">
      登録済みのメールアドレスを入力してください。<br>
      再設定用のリンクをお送りします。
    </p>
  </div>

  <%= form_for(resource,
        as: resource_name,
        url: password_path(resource_name),
        html: { method: :post, class: "space-y-6" }) do |f| %>

    <!-- メールアドレス -->
    <div class="space-y-2">
      <%= f.label :email,
            class: "block text-sm font-bold ml-1 #{resource.errors[:email].present? ? 'text-red-600' : 'text-gray-700'}" do %>
        メールアドレス
      <% end %>

      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
          <span class="material-symbols-outlined text-gray-400">email</span>
        </div>

        <% border_class = resource.errors[:email].present? ? 'border-red-400 bg-red-50' : 'border-gray-300' %>

        <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              placeholder: "example@mabatalk.com",
              class: "w-full pl-11 pr-4 py-4 rounded-2xl bg-white border #{border_class}
                      focus:border-amber-500 focus:ring-2 focus:ring-amber-200
                      focus:outline-none transition" %>
      </div>

      <% if resource.errors[:email].present? %>
        <p class="text-sm text-red-600 ml-1">
          <%= resource.errors[:email].first %>
        </p>
      <% end %>
    </div>

    <!-- 送信ボタン -->
    <button type="submit"
      class="w-full bg-amber-600 hover:bg-amber-700
              text-white font-bold text-lg py-4 rounded-full shadow-lg
              transform active:scale-95 transition-all
              flex items-center justify-center gap-2">
        <span>再設定メールを送信</span>
    </button>

  <% end %>

  <!-- ログインへ戻る -->
  <div class="text-center mt-8">
    <%= link_to "ログイン画面へ戻る",
          new_user_session_path,
          class: "text-sm text-gray-600 underline hover:text-gray-800" %>
  </div>

</main>

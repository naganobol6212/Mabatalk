<% content_for :page_title do %>
  <%= t("feedbacks.new.title") %>
<% end %>

<main class="relative min-h-screen w-full bg-stone-200 overflow-x-hidden pb-24">
  <div class="flex flex-col items-center px-4 pt-10 w-full max-w-md mx-auto">

    <div class="w-full bg-white/90 backdrop-blur rounded-2xl shadow border border-stone-100 p-6 space-y-6">

      <%# ヘッダー %>
      <div class="text-center space-y-2">
        <div class="flex justify-center">
          <span class="material-symbols-outlined text-sky-500 text-[48px]">
            chat
          </span>
        </div>
        <h2 class="text-xl font-bold text-stone-800">
          <%= t("feedbacks.new.title") %>
        </h2>
        <p class="text-sm text-stone-600">
          <%= t("feedbacks.new.description") %>
        </p>
      </div>

      <%# エラー表示 %>
      <% if @feedback.errors.any? %>
        <div class="rounded-xl bg-red-50 border border-red-200 p-4">
          <ul class="text-sm text-red-700 list-disc list-inside space-y-1">
            <% @feedback.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# フォーム %>
      <%= form_with model: @feedback, local: true, html: { multipart: true, class: "space-y-5" } do |f| %>

        <%# カテゴリ選択 %>
        <div>
          <%= f.label :category, class: "block text-sm font-bold text-stone-700 mb-2" %>
          <div class="space-y-2">
            <% Feedback.categories.each_key do |key| %>
              <label class="flex items-center gap-3 p-3 bg-stone-50 rounded-xl border border-stone-200 cursor-pointer hover:bg-stone-100 transition">
                <%= f.radio_button :category, key, class: "w-5 h-5 accent-amber-600" %>
                <span class="text-stone-800 font-medium">
                  <%= t("feedbacks.categories.#{key}") %>
                </span>
              </label>
            <% end %>
          </div>
        </div>

        <%# 本文 %>
        <div>
          <%= f.label :body, class: "block text-sm font-bold text-stone-700 mb-2" %>
          <%= f.text_area :body,
                rows: 6,
                maxlength: Feedback::BODY_MAX_LENGTH,
                placeholder: "ご意見をお聞かせください",
                class: "w-full bg-stone-50 rounded-xl p-4 text-stone-800 border border-stone-200 focus:outline-none focus:ring-2 focus:ring-amber-400" %>
        </div>

        <%# スクショ添付 %>
        <div>
          <%= f.label :screenshots, class: "block text-sm font-bold text-stone-700 mb-2" %>
          <%= f.file_field :screenshots,
                multiple: true,
                accept: "image/png,image/jpeg,image/gif",
                class: "w-full text-sm text-stone-700 bg-stone-50 rounded-xl border border-stone-200 p-2 file:mr-3 file:px-4 file:py-2 file:rounded-full file:border-0 file:bg-amber-100 file:text-amber-700 file:font-bold hover:file:bg-amber-200 cursor-pointer" %>
          <p class="mt-1 text-xs text-stone-500">
            最大<%= Feedback::MAX_SCREENSHOTS %>枚まで（JPG/PNG/GIF・1枚<%= Feedback::MAX_SCREENSHOT_SIZE / 1.megabyte %>MB以下）
          </p>
        </div>

        <%# 送信ボタン %>
        <div class="pt-2">
          <%= f.submit t("feedbacks.new.submit"),
                class: "w-full bg-amber-600 hover:bg-orange-600 text-white font-bold text-lg py-4 rounded-xl transition-all active:scale-[0.98] cursor-pointer" %>
        </div>
      <% end %>

      <%# 設定へ戻るリンク %>
      <div class="text-center pt-2">
        <%= link_to settings_path, class: "text-sm text-stone-500 hover:text-stone-700" do %>
          設定へ戻る
        <% end %>
      </div>

    </div>
  </div>
</main>

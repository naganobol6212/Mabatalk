<% content_for :back_path, message_categories_path %>
<% content_for :page_title do %>
  <%= @message_category.name %>
<% end %>

<% content_for :edit_mode_enabled, true %>

<main class="relative min-h-screen w-full bg-stone-200 overflow-x-hidden pb-24">
  <div class="flex flex-col items-center px-4 pt-6 w-full max-w-md md:max-w-4xl mx-auto">

    <!-- フロー項目一覧 -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 w-full"
         data-controller="reorder"
         data-reorder-url-value="<%= reorder_message_category_flow_items_path(@message_category) %>">
      <% @flow_items.each do |item| %>
        <% if item.user_id? %>
          <div class="relative" data-reorder-card data-id="<%= item.id %>">
        <% else %>
          <div class="relative" data-reorder-card>
        <% end %>
          <%= render "shared/square_card",
              path: confirm_message_category_flow_item_path(@message_category, item),
              icon: item.icon,
              icon_color: icon_color_class(item.icon_color),
              title: item.name,
              kana: item.kana %>
          <% if current_user && item.user_id? %>
            <div data-edit-mode-target="editOnly"
                 class="hidden absolute top-2 right-2 z-10">
              <div class="flex flex-col gap-1">
                <button data-action="click->reorder#moveUp"
                        class="w-8 h-8 flex items-center justify-center rounded-full bg-stone-100 text-stone-600 hover:bg-stone-200 transition">
                  <span class="material-symbols-outlined text-[18px]!">arrow_upward</span>
                </button>
                <button data-action="click->reorder#moveDown"
                        class="w-8 h-8 flex items-center justify-center rounded-full bg-stone-100 text-stone-600 hover:bg-stone-200 transition">
                  <span class="material-symbols-outlined text-[18px]!">arrow_downward</span>
                </button>
                <%= link_to edit_message_category_flow_item_path(@message_category, item),
                    class: "w-8 h-8 flex items-center justify-center rounded-full bg-blue-100 text-blue-500 hover:bg-blue-200 transition" do %>
                  <span class="material-symbols-outlined text-[18px]!">edit</span>
                <% end %>
                <%= button_to message_category_flow_item_path(@message_category, item),
                    method: :delete,
                    form: { data: { turbo_confirm: t("flow_items.destroy.confirm") } },
                    class: "w-8 h-8 flex items-center justify-center rounded-full bg-red-100 text-red-500 hover:bg-red-200 transition" do %>
                  <span class="material-symbols-outlined text-[18px]!">delete</span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- 項目追加（編集モード時のみ） -->
    <% if current_user %>
      <div data-edit-mode-target="editOnly" class="hidden w-full mt-6">
        <%= link_to new_message_category_flow_item_path(@message_category),
          class: "w-full h-14 flex items-center justify-center gap-2 rounded-xl
                  bg-white font-bold text-amber-700 shadow-sm
                  ring-1 ring-amber-200 hover:bg-amber-50
                  active:scale-[0.98] transition" do %>
          <span class="material-symbols-outlined">add_circle</span>
          項目を追加
        <% end %>
      </div>
    <% end %>

  </div>
</main>

<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "MabaTalk" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Description -->
    <meta name="description" content="声が出せなくても、身体が動かせなくても。まばたきでつながるコミュニケーション支援アプリ｜MabaTalk">

    <!-- OGP -->
    <meta property="og:title" content="MabaTalk">
    <meta property="og:description" content="声が出せなくても、身体が動かせなくても。まばたきでつながるコミュニケーション支援アプリ｜MabaTalk">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://mabatalk.com">
    <meta property="og:image" content="https://mabatalk.com/ogp.png">
    <meta property="og:locale" content="ja_JP">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="MabaTalk">
    <meta name="twitter:description" content="声が出せなくても、身体が動かせなくても。まばたきでつながるコミュニケーション支援アプリ｜MabaTalk">
    <meta name="twitter:image" content="https://mabatalk.com/ogp.png">

    <!-- Theme Color -->
    <meta name="theme-color" content="#fb8603">

    <%= yield :head %>

    <% if Rails.env.production? && ENV["GA_MEASUREMENT_ID"].present? %>
      <!-- Google tag (gtag.js) -->
      <script async src="https://www.googletagmanager.com/gtag/js?id=<%= ENV["GA_MEASUREMENT_ID"] %>"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', '<%= ENV["GA_MEASUREMENT_ID"] %>', {
          send_page_view: false
        });
      </script>
    <% end %>

    <!-- Material Symbols（追加） -->
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
      rel="stylesheet"
    >
    <meta name="theme-color" content="#fb8603">

    <link rel="manifest" href="/manifest.json">

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon-192.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

<body>
  <%= render 'shared/header' %>

  <% flash.each do |type, message| %>

    <% bg_class =
      case type.to_sym
      when :notice
        "bg-emerald-50 text-emerald-700 border-emerald-200"
      when :alert
        "bg-red-50 text-red-700 border-red-200"
      else
        "bg-gray-50 text-gray-700 border-gray-200"
      end %>

    <% icon_name =
      case type.to_sym
      when :notice
        "check_circle"
      when :alert
        "error"
      else
        "info"
      end %>

    <% icon_color =
      case type.to_sym
      when :notice
        "text-emerald-600"
      when :alert
        "text-red-600"
      else
        "text-gray-600"
      end %>

    <div
      class="fixed top-4 inset-x-0 z-50 flex justify-center"
      data-controller="flash"
    >

      <div class="relative w-full max-w-md rounded-xl p-4 shadow-sm border <%= bg_class %>">

        <!-- 閉じる -->
        <button
          type="button"
          data-action="click->flash#close"
          class="absolute top-2 right-2 text-gray-400 hover:text-gray-600"
          aria-label="閉じる"
        >
          ×
        </button>

        <div class="flex items-center gap-3 text-left">
          <span class="material-symbols-outlined <%= icon_color %>">
            <%= icon_name %>
          </span>
          <span class="text-base sm:text-lg font-medium">
            <%= message %>
          </span>
        </div>
      </div>
    </div>
  <% end %>
  <%= yield %>

  <%= yield :legal_links %>

  <%= render 'shared/footer' %>
</body>
</html>

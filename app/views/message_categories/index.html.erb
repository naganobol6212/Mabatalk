<% content_for :page_title do %>
  メッセージカテゴリ
<% end %>

<% content_for :edit_mode_enabled, true %>

<main class="relative min-h-screen w-full bg-stone-200 pb-24">
  <div class="flex flex-col items-center px-4 pt-6 w-full max-w-md mx-auto">

    <!-- カテゴリ一覧 -->
    <div class="grid grid-cols-2 gap-4 w-full">
      <% @message_categories.each do |message_category| %>
        <div class="relative">
          <%= render "shared/square_card",
              path: message_category_flow_items_path(message_category),
              icon: message_category.icon,
              icon_color: icon_color_class(message_category.icon_color),
              title: message_category.name,
              kana: message_category.kana %>
          <% if current_user && message_category.user_id? %>
            <div data-edit-mode-target="editOnly"
                 class="hidden absolute top-2 right-2 z-10">
              <div class="flex flex-col gap-1">
                <%= link_to edit_message_category_path(message_category),
                    class: "w-8 h-8 flex items-center justify-center rounded-full bg-blue-100 text-blue-500 hover:bg-blue-200 transition" do %>
                  <span class="material-symbols-outlined text-[18px]!">edit</span>
                <% end %>
                <%= button_to message_category_path(message_category),
                    method: :delete,
                    form: { data: { turbo_confirm: t("message_categories.destroy.confirm") } },
                    class: "w-8 h-8 flex items-center justify-center rounded-full bg-red-100 text-red-500 hover:bg-red-200 transition" do %>
                  <span class="material-symbols-outlined text-[18px]!">delete</span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>

  <!-- 画面下部固定エリア（編集モード時のみ） -->
  <% if user_signed_in? %>
    <div data-edit-mode-target="editOnly"
         class="hidden fixed inset-x-0 bottom-24 z-20
                bg-linear-to-t from-stone-200 via-stone-200/90 to-transparent
                px-4 pb-4 pt-10 pointer-events-none">
      <div class="flex justify-center w-full max-w-md mx-auto pointer-events-auto">
        <%= link_to new_message_category_path,
          class: "w-full h-14 flex items-center justify-center gap-2 rounded-xl
                  bg-white font-bold text-amber-700 shadow-sm
                  ring-1 ring-amber-200 hover:bg-amber-50
                  active:scale-[0.98] transition" do %>
          <span class="material-symbols-outlined">add_circle</span>
          カテゴリを追加
        <% end %>
      </div>
    </div>
  <% end %>

</main>

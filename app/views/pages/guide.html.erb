<% content_for :page_title do %>
  使い方ガイド
<% end %>

<main class="relative flex min-h-screen w-full flex-col bg-stone-200 overflow-x-hidden pb-24">
  <div class="flex flex-col items-center px-4 pt-8 w-full max-w-md mx-auto">

    <!-- Hero -->
    <section class="w-full mb-10 text-center">
      <p class="text-sm font-bold tracking-wide text-stone-500">
        まばたきでつながる
      </p>

      <h1 class="text-3xl font-black tracking-tight text-amber-700">
        使い方ガイド
      </h1>
    </section>

    <!-- Steps -->
    <%= render "shared/steps" %>

    <!-- ログインしたらできること -->
    <%= render "shared/login_features" %>

    <!-- まばたき入力（カメラ）のデータの扱い -->
    <section id="blink-input" class="w-full mb-12">
      <div class="flex items-center gap-2 mb-4 px-2">
        <span class="material-symbols-outlined text-amber-700">shield_person</span>
        <h3 class="text-lg font-bold text-stone-800"><%= t(".blink_input.heading") %></h3>
      </div>

      <p class="mb-6 px-2 text-sm text-stone-600 leading-relaxed"><%= t(".blink_input.preparing") %></p>

      <div class="flex flex-col gap-8">
        <% t(".blink_input.items").each do |item| %>
          <div class="flex items-start gap-4">
            <div class="flex items-center justify-center w-10 h-10 rounded-full bg-white border-2 border-amber-600 text-amber-700 shadow-sm shrink-0">
              <span class="material-symbols-outlined text-[20px]"><%= item[:icon] %></span>
            </div>
            <div class="flex-1 bg-white p-5 rounded-2xl shadow-sm space-y-2">
              <h4 class="font-bold text-stone-800"><%= item[:title] %></h4>
              <p class="text-sm text-stone-600 leading-relaxed"><%= item[:description] %></p>
            </div>
          </div>
        <% end %>
      </div>

      <p class="mt-6 px-2 text-sm">
        <%= link_to t(".blink_input.privacy_policy_link"), privacy_policy_path(anchor: "blink-input"), class: "link text-amber-700" %>
      </p>
    </section>

    <!-- 戻る -->
    <section class="w-full mb-6">
      <%= link_to "設定に戻る",
          settings_path,
          class: "
            w-full h-14
            flex items-center justify-center
            rounded-full
            bg-amber-600
            text-white
            text-lg font-bold
            shadow
            hover:bg-amber-700
            active:scale-[0.98]
            transition
          "
      %>
    </section>

  </div>
</main>

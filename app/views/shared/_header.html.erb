<header class="relative flex items-center justify-between px-6 py-4 sticky top-0 z-20 bg-stone-200/90 backdrop-blur border-b border-white/40">
  <div class="z-10">
    <h1 class="flex items-center">
      <%= render "shared/logo" %>
    </h1>
  </div>

  <!-- 中央：ページタイトル -->
  <div class="absolute left-0 right-0 flex justify-center pointer-events-none">
    <h2 class="text-sm font-bold text-stone-700 pointer-events-auto">
      <%= content_for?(:page_title) ? yield(:page_title) : "" %>
    </h2>
  </div>

  <!-- 右：ログイン / 編集トグル -->
  <div class="z-10">
    <% if !user_signed_in? %>
      <!-- 未ログイン：ログイン -->
      <%= link_to "ログイン",
                  new_user_session_path,
                  class: "
                    text-amber-700
                    font-bold
                    text-sm
                    px-4
                    py-2
                    rounded-full
                    border
                    border-amber-300
                    bg-white
                    hover:bg-amber-50
                    transition-colors
                  " %>
    <% elsif content_for?(:edit_mode_enabled) %>
      <!-- ログイン中 かつ 編集対応ページ：編集トグル -->
      <button
        type="button"
        aria-pressed="false"
        data-action="click->edit-mode#toggle"
        data-edit-mode-target="toggleButton"
        class="
          flex items-center gap-1
          text-amber-700
          font-bold
          text-sm
          px-4
          py-2
          rounded-full
          border
          border-amber-300
          bg-white
          hover:bg-amber-50
          transition-colors
        ">
        <span class="material-symbols-outlined text-[16px]!"
              data-edit-mode-target="toggleIcon">edit</span>
        <span data-edit-mode-target="toggleLabel">編集する</span>
      </button>
    <% end %>
  </div>
</header>

<section class="w-full mb-12">
  <div class="flex items-center gap-2 mb-6 px-2">
    <span class="material-symbols-outlined text-amber-700">verified_user</span>
    <h3 class="text-lg font-bold text-stone-800">ログインしたらできること</h3>
  </div>

  <div class="flex flex-col gap-8">
    <% login_features.each do |f| %>
      <div class="flex items-start gap-4">
        <div class="flex items-center justify-center w-10 h-10 rounded-full bg-white border-2 border-amber-600 text-amber-700 shadow-sm shrink-0">
          <span class="material-symbols-outlined text-[20px]"><%= f[:icon] %></span>
        </div>
        <div class="flex-1 bg-white p-5 rounded-2xl shadow-sm space-y-2">
          <h4 class="font-bold text-stone-800"><%= f[:title] %></h4>
          <p class="text-sm text-stone-600 leading-relaxed"><%= f[:description] %></p>
        </div>
      </div>
    <% end %>
  </div>
</section>

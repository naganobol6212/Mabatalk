<% minimum_length ||= nil %>
<% autocomplete ||= "new-password" %>
<% autofocus ||= false %>
<% left_icon ||= nil %>

<div class="space-y-2" data-controller="password-whitespace">

  <!-- ラベル -->
  <%= f.label field,
        class: "block text-sm font-bold ml-1 #{errors.present? ? 'text-red-600' : 'text-gray-700'}" do %>
    <%= label %>
  <% end %>

  <!-- 最小文字数 -->
  <% if minimum_length.present? %>
    <p class="text-xs text-gray-500 ml-1">
      ※ <%= minimum_length %>文字以上で入力してください
    </p>
  <% end %>

  <div data-controller="password-toggle" class="relative">

    <% border_class = errors.present? ? 'border-red-400 bg-red-50' : 'border-gray-300' %>
    <% padding_left = left_icon.present? ? "pl-11" : "pl-4" %>

    <% if left_icon.present? %>
      <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
        <span class="material-symbols-outlined text-gray-400">
          <%= left_icon %>
        </span>
      </div>
    <% end %>

    <%= f.password_field field,
          autocomplete: autocomplete,
          autofocus: autofocus,
          data: {
            password_toggle_target: "input",
            action: "input->password-whitespace#check"
          },
          class: "w-full #{padding_left} pr-12 py-4 rounded-2xl bg-white border #{border_class}
                  focus:border-amber-500 focus:ring-2 focus:ring-amber-200
                  focus:outline-none transition" %>

    <!-- トグル -->
    <button type="button"
            data-action="click->password-toggle#toggle"
            class="absolute inset-y-0 right-3 flex items-center text-gray-400 hover:text-amber-600 transition"
            aria-label="パスワード表示切替">

      <span data-password-toggle-target="icon"
            class="material-symbols-outlined text-xl">
        visibility_off
      </span>

    </button>

  </div>

  <p class="text-sm text-yellow-600 ml-1 hidden"
    data-password-whitespace-target="warning">
    <%= t("helpers.password_field.no_whitespace") %>
  </p>

  <!-- エラー -->
  <% if errors.present? %>
    <p class="text-sm text-red-600 ml-1">
      <%= errors.first %>
    </p>
  <% end %>

</div>

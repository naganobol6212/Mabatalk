<%= link_to path,
  class: "
    bg-white/90 backdrop-blur rounded-2xl p-6 aspect-square
    flex flex-col justify-between items-center text-center
    shadow-[0_6px_14px_rgba(0,0,0,0.08)]
    hover:shadow-[0_10px_22px_rgba(0,0,0,0.12)]
    transition-shadow duration-200
    active:scale-[0.98]
    focus:outline-none focus:ring-4 focus:ring-stone-300
    group
  " do %>

  <!-- アイコン -->
  <span class="
    material-symbols-outlined
    !text-[52px] md:!text-[88px]
    <%= icon_color %>
    transition-transform
    group-hover:scale-110
  ">
    <%= icon %>
  </span>

  <!-- テキストエリア -->
  <div class="h-[72px] md:h-[120px] flex flex-col justify-center md:gap-3">
    <span class="
      text-[22px] md:text-[34px]
      font-bold
      text-stone-900
      leading-tight
      line-clamp-2
    ">
      <%= title %>
    </span>

    <span class="
      text-[15px] md:text-[22px]
      text-stone-700
      leading-tight
      line-clamp-2
    ">
      <%= kana %>
    </span>
  </div>

<% end %>
